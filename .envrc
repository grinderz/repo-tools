# rt finds ~/.config/repo-tools/config.yaml on its own (dotfiles link that
# directory to the syncthing-carried ~/sync/work/repo-tools, where the real
# configs live and config.yaml points at the current release config), so
# nothing is exported here. A release config is still selected for one
# shell with the environment variable or per command with -c:
#   REPO_TOOLS_CONFIG=~/.config/repo-tools/config-2026.06.yaml rt release branch
#   rt -c ~/.config/repo-tools/config-2026.06.yaml release branch
# or for this checkout by putting the export into .envrc.local (gitignored).
source_env_if_exists .envrc.local
