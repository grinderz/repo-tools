# Config rt picks up in this checkout. Without it, rt only finds ./config.yaml
# when run from the repository root, and falls back to
# ~/.config/repo-tools/config.yaml everywhere else.
export REPO_TOOLS_CONFIG="${PWD}/config.yaml"

# Release runs override it for one shell:
#   REPO_TOOLS_CONFIG=$PWD/config-2026.06.yaml rt release branch
# or per command: rt -c config-2026.06.yaml release branch
# or for the whole checkout, by putting the line below in .envrc.local:
#   export REPO_TOOLS_CONFIG="${PWD}/config-2026.06.yaml"
source_env_if_exists .envrc.local
